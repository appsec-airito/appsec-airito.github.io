---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, href } from '../site.config';

const focus = [
  { h: 'Cloud security at scale', p: 'Securing enterprise cloud environments end to end — including critical-infrastructure moves from legacy data centers to AWS — with automated, continuous certification across large application portfolios.' },
  { h: 'AI-driven threat modeling', p: 'Building the tooling and running the enablement programs that scale threat modeling and Secure Product Life Cycle practices — training 700+ principals, engineers, and managers to build secure software.' },
  { h: 'Security automation', p: 'Engineering automation that removes manual toil — cutting privacy and incident-response review effort by double digits and standing up detection frameworks that scale.' },
  { h: 'Offensive & AI security testing', p: 'Leading hands-on security assessments — penetration testing and adversarial prompt testing of AI and LLM systems — to find weaknesses before attackers do.' },
  { h: 'Leadership & strategy', p: 'Building high-performing security teams and turning security from a cost center into a competitive advantage.' },
  { h: 'Security that speaks business', p: 'Working where deep technical security meets the P&L — a founder and operator who translates risk into decisions the business can actually act on.' },
];
---
<BaseLayout>
  <section class="hero">
    <div class="wrap">
      <span class="role">{SITE.role}</span>
      <h1>{SITE.name}</h1>
      <p class="tagline">{SITE.tagline}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={href('/about')}>About me</a>
        {SITE.email && <a class="btn btn-ghost" href={`mailto:${SITE.email}`}>Get in touch</a>}
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section>
    <div class="wrap">
      <span class="section-title">What I focus on</span>
      <p class="note" style="color:var(--text); font-size:1.05rem; margin-top:8px;">
        A security leader who stays hands-on — building the tools, breaking the systems, and
        automating the toil — while translating all of it into what the business is trying to do.
      </p>
      <div class="grid">
        {focus.map((f) => (
          <div class="card"><h3>{f.h}</h3><p>{f.p}</p></div>
        ))}
      </div>
    </div>
  </section>


</BaseLayout>
